## Local development database (Postgres 16).
## Swap for a hosted connection string (Railway, Supabase, RDS, etc.) in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/realtime_os?schema=public"

## Auth.js (NextAuth v5) — generate a real secret for production:
##   openssl rand -base64 32
AUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

## --- Email (magic link) --------------------------------------------------
## Dev default: no SMTP configured, magic links are printed to the server
## console instead of sent. Drop in real SMTP creds to send real emails.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Realtime OS <no-reply@realtime.local>"

## --- Google (Calendar + Gmail) --------------------------------------------
## Dev default: unset, the app runs against the mock Calendar/Gmail adapters
## in src/lib/integrations. Drop in real OAuth credentials to go live.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

## --- Xero / bank feed ------------------------------------------------------
## Dev default: unset, Finance uses manual CSV upload only. Drop in real
## Xero OAuth credentials to enable the live bank-feed adapter.
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""

## --- Anthropic (AI rewrite / "Customise with AI") -------------------------
## Dev default: unset, AI actions fall back to a deterministic mock rewrite
## so the feature is fully usable without a key. Drop in a real key to call
## the live model.
ANTHROPIC_API_KEY=""

## --- File storage (CRM/Finance uploads) ------------------------------------
## Dev default: unset, uploads are written to public/uploads on local disk,
## which does not persist on serverless hosts like Vercel. Attach Vercel Blob
## storage to the project (this sets the token automatically) to go live.
BLOB_READ_WRITE_TOKEN=""
